FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY *csproj ./

RUN dotnet restore

COPY . .

RUN dotnet publish -c Release -o /publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0

WORKDIR /app

# git: required by CloneService.CloneAsync (shells out to the `git` binary)
# libgssapi-krb5-2: silences Npgsql's native GSSAPI probe on startup
RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /publish .

ENTRYPOINT ["dotnet", "RepoGeist.dll"]